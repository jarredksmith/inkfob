<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the INFOPLIST_KEY_* settings in project.yml. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- bluetooth-central: the pager can wake the app to ask for fresh weather and calendar lines.
	     audio: lets "Find my phone" ring when the pager asks while the app is in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
</dict>
</plist>
